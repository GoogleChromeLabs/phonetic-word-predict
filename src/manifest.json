{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.0.03",
  "author": "Clay Smith",
  "short_name": "__MSG_appName__",
  "default_locale": "fr",
  "description": "Word Prediction",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "images/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "js": [
        "runtime.js",
        "polyfills.js",
        "main.js",
        "contentscript.js"
      ],
      "css": [
        "styles.css"
      ],
      "all_frames": true
    }
  ]
}
